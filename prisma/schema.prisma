generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  phone            String?
  passwordHash     String?
  name             String
  role             String    @default("CUSTOMER") // MERCHANT or CUSTOMER
  esellCode        String?   @unique
  businessCategory String?
  logoUrl          String?
  trustBadge       String    @default("RED") // GREEN, RED, BLUE
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  storefronts     Storefront[]
  walletAddresses WalletAddress[]
  deployedTokens  DeployedToken[]
  sentMessages    Message[]       @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  notifications   Notification[]
  trustProfile    TrustProfile?
  media           Media[]

  accounts Account[]
  sessions Session[]
}

model Storefront {
  id           String   @id @default(uuid())
  userId       String
  themeId      String?
  customColors String?
  aboutUs      String?
  address      String?
  socialLinks  String?
  bankDetails  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme    Theme?   @relation(fields: [themeId], references: [id])
  products Product[]
  services Service[]
  staff    Staff[]

  @@index([userId])
}

model Product {
  id           String   @id @default(uuid())
  storefrontId String
  name         String
  description  String?
  priceNGN     Float
  priceCrypto  String?
  images       String?
  category     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId])
}

model Service {
  id           String   @id @default(uuid())
  storefrontId String
  name         String
  description  String?
  priceNGN     Float
  priceCrypto  String?
  duration     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId])
}

model WalletAddress {
  id         String   @id @default(uuid())
  userId     String
  network    String   @default("BSC")
  address    String
  qrCodeUrl  String?
  label      String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeployedToken {
  id              String   @id @default(uuid())
  userId          String
  contractAddress String
  tokenAddress    String
  network         String   @default("BSC")
  name            String
  symbol          String
  supply          Int
  mintable        Boolean  @default(false)
  pausable        Boolean  @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id           String    @id @default(uuid())
  senderId     String
  recipientId  String
  storefrontId String?
  content      String
  type         String    @default("TEXT") // TEXT, VOICE, FILE, VIDEO
  mediaUrl     String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String    // PAYMENT, MESSAGE, CONTRACT, SYSTEM
  title       String
  body        String?
  referenceId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Staff {
  id              String   @id @default(uuid())
  storefrontId    String
  name            String
  role            String
  email           String?
  phone           String?
  bio             String?
  profileImageUrl String?
  createdAt       DateTime @default(now())

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId])
}

model TrustProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  badge               String   @default("RED") // GREEN, RED, BLUE
  totalTrades         Int      @default(0)
  successfulPurchases Int      @default(0)
  accountAge          Int      @default(0)
  responseTime        Int      @default(0)
  satisfactionScore   Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id          String    @id @default(uuid())
  userId      String
  entityType  String
  entityId    String
  mediaType   String    // IMAGE, VIDEO, AUDIO, DOCUMENT
  url         String
  publicId    String?
  fileSize    Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
}

model Theme {
  id              String   @id @default(uuid())
  name            String
  category        String?
  previewImageUrl String?
  layoutConfig    String?
  defaultColors   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  storefronts Storefront[]
}

// NextAuth models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
